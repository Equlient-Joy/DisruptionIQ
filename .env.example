# Production/development PostgreSQL connection. docker compose up -d provisions it.
# DATABASE_URL=postgres://disruptioniq:local-demo-password@127.0.0.1:5432/disruptioniq
PORT=3000
# Explicit local-only alternative: PGlite is embedded PostgreSQL, persisted to disk.
DATABASE_MODE=pglite
PGLITE_PATH=.data/workspace
# Set PGLITE_PATH=memory:// for a disposable, in-memory workspace.
DEMO_MODE=true
DEMO_PASSWORD=disruption-demo
APP_ORIGIN=http://127.0.0.1:3000
# When demo mode is disabled, bootstrap a private administrator explicitly.
ADMIN_EMAIL=
ADMIN_PASSWORD=
WEBHOOK_SECRET=local-carrier-demo
# AI Copilot & Autonomous Agent Provider Settings
# Enable AI features for the conversational copilot, triage agent, recovery advisor, and summarizer:
AI_FEATURES_ENABLED=false
# Google Gemini API configuration (Default: gemini-3.8-flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Alternative: OpenAI-compatible provider
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
