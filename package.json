{
  "name": "disruptioniq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "bun src/server/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun src/server/migrate.ts",
    "db:seed": "bun src/server/seed.ts",
    "test:e2e": "playwright test",
    "generate:enterprise": "bun scripts/generate-enterprise-data.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@tanstack/react-query": "^5.90.0",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.9",
    "lucide-react": "^0.545.0",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^5.4.296",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/bun": "^1.3.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
